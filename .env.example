# Where answers say this server lives. Unset, and each answer names whichever
# host the request arrived on, which is what a laptop wants and a CDN does not.
PUBLIC_URL=https://lens.example.com
HOST=0.0.0.0
PORT=8787

# --- the store ---------------------------------------------------------------
# git:    one JSON file per canvas in a repository, compare-and-swap by blob id
#         and by fast-forward push, revision history for free.
# memory: forgets everything on restart. For a look around, not for keeping.
STORE=git

# Anything git can fetch from and push to. A private repository is the point.
#   https://gitlab.example.com/my-group/pr-lens-canvases.git
#   ssh://git@github.com/my-org/pr-lens-canvases.git
GIT_REMOTE=https://gitlab.example.com/my-group/pr-lens-canvases.git
# The password half of basic auth on an https remote: a project access token, a
# PAT, a deploy token. Leave empty for ssh, which authenticates with a key --
# point GIT_SSH_COMMAND at it, the same as you would for any other git.
GIT_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx
# The user half. Most hosts ignore it when the password is a token; Bitbucket
# wants x-token-auth.
GIT_USERNAME=oauth2
GIT_BRANCH=main
GIT_PREFIX=canvases
GIT_AUTHOR_NAME=pr-lens-git-backend
GIT_AUTHOR_EMAIL=pr-lens-git-backend@example.com
# Where the mirror of the repository lives. It is a cache, not a copy of record:
# delete it and the next call clones again.
GIT_MIRROR_DIR=/tmp/pr-lens-canvases.git
# How long a fetched view may be reused. Zero asks the remote on every read the
# read cache did not answer, which is what the freshness promise rests on.
GIT_FETCH_TTL_MS=0
# Ceiling on a single git invocation.
GIT_TIMEOUT_MS=30000
# The host named in the User-Agent sent to an https remote, so its logs can tell
# replicas apart. Defaults to this machine's host name; set empty to send none.
USER_AGENT_HOST=

# --- limits and caches -------------------------------------------------------
# The hosted app's limit, and above anything the contract accepts.
MAX_BODY_BYTES=4000000
# How long a read may be answered from memory before the remote is asked again.
READ_CACHE_TTL_MS=5000
# Ceiling on rendered SVG bytes held in memory.
RENDER_CACHE_BYTES=64000000
# false turns this into a pure store: every answer carries tiles: [].
DRAW=true

# Zero on either turns that meter off.
MINTS_PER_HOUR_PER_IP=60
PUSHES_PER_MINUTE_PER_CANVAS=30

# The pictures are content-addressed, so their bytes can never change.
IMAGE_CACHE_CONTROL=public, max-age=31536000, immutable
# The embed is not, so it is revalidated against its render's hash.
EMBED_CACHE_CONTROL=public, max-age=60, stale-while-revalidate=300

# Believe x-forwarded-for and x-forwarded-proto. Only behind a proxy you own.
TRUST_PROXY=false
LOG_REQUESTS=true
# The page at /. false answers NOT_FOUND there, for a deployment that would rather
# not say what it is -- including when INDEX_MARKDOWN_FILE names one.
INDEX_PAGE=true
# A Markdown file to serve at / instead of that page. Re-read when it changes, so
# a ConfigMap can be edited without a rollout. {{origin}}, {{store}}, {{canvases}},
# {{version}} and {{diagrams}} are filled in. Raw HTML is allowed; scripts are not.
INDEX_MARKDOWN_FILE=

# --- who may mint, and who may see code ---------------------------------------
# Comma-separated bearer tokens allowed to mint a canvas (POST /api/canvas). The
# CLI sends PR_LENS_TOKEN as that bearer, so CI sets PR_LENS_TOKEN to one of
# these. Empty leaves minting open to anyone. Only hashes are kept in memory.
#   prl_u_$(openssl rand -base64 16 | tr '+/' '-_' | tr -d '=')
PUSH_TOKENS=

# Clicking a diagram element shows the code it stands for, read from GitHub with
# the reader's own token. Readers sign in through a GitHub App (user
# authorization, Contents: read). Its callback URL is <PUBLIC_URL>/auth/github/callback.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# 32 random bytes, base64: openssl rand -base64 32. Seals the session cookie.
SESSION_KEY=
# Local development only: read diffs with this token when nobody is signed in.
# Refused unless HOST is loopback. GITHUB_DEV_TOKEN=$(gh auth token)
GITHUB_DEV_TOKEN=
# GitHub Enterprise Server: point both at your host.
GITHUB_API_URL=https://api.github.com
GITHUB_WEB_URL=https://github.com
